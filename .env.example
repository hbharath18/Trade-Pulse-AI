PORT=4100
DB_PATH=./tradepulse.sqlite
FRONTEND_ORIGIN=http://localhost:3000

ENABLE_OVERTURE=true
OVERTURE_RELEASE=2026-11-18.0
OVERTURE_GRID=2
OVERTURE_ROWS_PER_TILE=3000
MAX_LEADS_PER_SCAN=1800
MAX_WEBSITES_PER_SCAN=900
WEBSITE_CONCURRENCY=5
MAX_PAGES_PER_WEBSITE=6
EMAIL_DOMAIN_CHECK=true

# Optional Discovery APIs
GEOAPIFY_API_KEY=your_geoapify_key
ENABLE_OVERPASS=true
TOMTOM_API_KEY=your_tomtom_key

# Gmail OAuth 2.0 (Web Application Client)
GOOGLE_OAUTH_CLIENT_TYPE=web
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:4100/api/gmail/callback

# OpenAI AI Pitch Drafting
ENABLE_OPENAI=true
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-5-mini

DAILY_EMAIL_CAP=50