# TRADEPULSE AI — only edit this file after copying it to server/.env
# This project is designed for LOCAL development. Never share .env files.
PORT=4100
DB_PATH=./tradepulse.sqlite
FRONTEND_ORIGIN=http://localhost:3000,http://localhost:3001,http://localhost:5173

# FREE, KEYLESS (default): Overture Maps open data via DuckDB and public business websites.
ENABLE_OVERTURE=true
OVERTURE_RELEASE=2026-11-18.0
# 2x2 geographic tiles; 3,000 Overture rows maximum from each tile => 12,000 initial listings.
OVERTURE_GRID=2
OVERTURE_ROWS_PER_TILE=3000
# Maximum outreach candidates to return if real product evidence and contacts are found; not a guarantee of qualified leads.
MAX_LEADS_PER_SCAN=1800
# First-party site checks can take several minutes. Increase carefully if needed.
MAX_WEBSITES_PER_SCAN=900
WEBSITE_CONCURRENCY=5
# Maximum first-party pages per website, including relevant product/contact links.
MAX_PAGES_PER_WEBSITE=6
# Crawler: per-request timeout, retries for transient errors only (timeouts/5xx/429/temporary DNS), per-site time budget.
WEBSITE_TIMEOUT_MS=10000
WEBSITE_RETRIES=1
WEBSITE_SITE_BUDGET_MS=30000
# Candidate selection. Listing scores: 100 name has 'singing bowl', 90 Tibetan/Himalayan/Nepal/metaphysical/crystal shop,
# 80 importer/wholesaler/handicraft, 60 generic gift/decor shop. Use MIN_LISTING_SCORE=90 for specialist-only scans.
MIN_LISTING_SCORE=60
# Unreachable / evidence-free sites are kept as research leads only if their listing score is at least this value.
MIN_ADJACENT_SCORE=70
MAX_RESEARCH_PER_SCAN=2000
# Also accept Overture rows with empty locality/region that fall inside the city bounding box (may include nearby suburbs).
OVERTURE_INCLUDE_UNLOCALIZED=false

# Studios / practitioners (yoga, sound bath, meditation) are LOW-priority research prospects: they only use leftover website-check
# capacity, up to this many per scan. 0 disables them entirely (and removes them from the Overture query).
MAX_STUDIO_CHECKS_PER_SCAN=100
# Studios that describe running sound-healing sessions with the instruments are "potential equipment purchasers" (never sellers).
# At most this many may be saved as outreach candidates per scan; the rest stay in Research Leads.
MAX_EQUIPMENT_USER_LEADS=100
# Website checks are cached so repeat scans (and a scan restarted after an interruption) do not re-crawl the same sites.
# Successful checks are reused for this many days; permanent failures for 3 days; 0 disables the cache.
RESCAN_AFTER_DAYS=14
# DNS-only check that an e-mail's domain can receive mail (MX / A record). It does NOT verify that the mailbox exists.
EMAIL_DOMAIN_CHECK=true
# Optional: override Geoapify place categories (comma separated, e.g. commercial.gift_and_souvenir,commercial.antiques).
GEOAPIFY_CATEGORIES=
CRAWLER_USER_AGENT=TradePulseAI/2.0 (public business research)

# Optional free hosted API; required only if using Geoapify. Free tiers have usage limits.
GEOAPIFY_API_KEY=
GEOAPIFY_PAGES_PER_SCAN=2

# Optional community Overpass API; public servers are shared. Limited one call / scan.
ENABLE_OVERPASS=false
# Update this to your real contact email for public OSM geocoding / Overpass.
NOMINATIM_USER_AGENT=TradePulseAI/2.0 (contact: put-your-email@example.com)

# Gmail OAuth: required only for approved email outreach / reply tracking.
# For a Web application OAuth client, add http://localhost:4100/api/gmail/callback
# as an authorized redirect URI in Google Cloud. Desktop loopback clients can also
# work, depending on the client type you created. Enable the Gmail API.
# Add your personal Gmail to OAuth Test Users if your app is in Testing.
# Testing-mode refresh tokens for these scopes may expire after ~7 days.
GOOGLE_OAUTH_CLIENT_TYPE=web
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4100/api/gmail/callback

# Optional AI drafting. Disabled by default. ChatGPT Plus is separate from API billing.
# AI is requested only when you click "Generate AI draft" for ONE chosen buyer.
ENABLE_OPENAI=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# Maximum per day: 50 email ATTEMPTS, not successful deliveries. Always manually approved.
# Must also configure real sender name/postal address inside Settings before sending.
DAILY_EMAIL_CAP=50
